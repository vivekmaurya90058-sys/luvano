<script>
const prices = {
    "500": 500,
    "600": 600,
    "800": 800,
    "1500": 1500,
    "3000": 3000
};

const category = document.getElementById("category");
const duration = document.getElementById("duration");

function getTotal() {
    const price = prices[category.value] || 0;

    return duration.value === "Yearly"
        ? price * 12
        : price;
}

function updateTotal() {
    const total = getTotal();

    document.getElementById("totalPrice").textContent =
        "₹" + total.toLocaleString("en-IN");

    document.getElementById("totalNote").textContent =
        duration.value + " subscription";
}

category.addEventListener("change", updateTotal);
duration.addEventListener("change", updateTotal);

function openPayment() {
    if (!category.value) {
        alert("Please select your car category first.");
        return;
    }

    document.getElementById("paymentBox").hidden = false;

    const total = getTotal();

    const upiUrl =
        "upi://pay?pa=maurya.mahendar1@axl" +
        "&pn=Vivek%20Maurya" +
        "&am=" + total +
        "&cu=INR" +
        "&tn=Luvano%20Auto%20Booking";

    window.location.href = upiUrl;
}

document.getElementById("bookingForm")
.addEventListener("submit", async function(event) {

    event.preventDefault();

    const data = {
        name: document.getElementById("name").value,
        mobile: document.getElementById("mobile").value,
        location: document.getElementById("location").value,
        category: category.options[category.selectedIndex].text,
        carDetails: document.getElementById("carDetails").value,
        duration: duration.value,
        time: document.getElementById("time").value,
        startDate: document.getElementById("startDate").value,
        total: getTotal(),
        utr: document.getElementById("utr").value,
        notes: document.getElementById("notes").value
    };

    try {
        const response = await fetch("/api/bookings", {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify(data)
        });

        if (!response.ok) {
            throw new Error("Booking failed");
        }

        const result = await response.json();

        const message =
            "LUVANO AUTO - NEW BOOKING\n\n" +
            "Booking ID: " + result.bookingId + "\n" +
            "Name: " + data.name + "\n" +
            "Mobile: " + data.mobile + "\n" +
            "Address: " + data.location + "\n" +
            "Car: " + data.category + "\n" +
            "Model: " + data.carDetails + "\n" +
            "Plan: " + data.duration + "\n" +
            "Start Date: " + data.startDate + "\n" +
            "Amount: ₹" + data.total + "\n" +
            "UTR: " + data.utr + "\n" +
            "Payment Status: UNVERIFIED\n" +
            "Booking Status: PENDING CONFIRMATION";

        const whatsappUrl =
            "https://wa.me/919794880034?text=" +
            encodeURIComponent(message);

        window.open(whatsappUrl, "_blank");

        alert(
            "Booking request saved.\n" +
            "Booking ID: " + result.bookingId +
            "\nPayment is not verified yet."
        );

    } catch (error) {
        alert("Unable to submit booking. Please try again.");
    }
});

updateTotal();
</script>

