package luv;

import org.springframework.boot.SpringApplication;
import org.springframework.boot.autoconfigure.SpringBootApplication;
import org.springframework.web.bind.annotation.*;

import java.time.Instant;
import java.util.*;
import java.util.concurrent.ConcurrentHashMap;

@SpringBootApplication
@RestController
@CrossOrigin
public class LuvanoAutoApplication {

    private final Map<String, Map<String, Object>> bookings =
            new ConcurrentHashMap<>();

    public static void main(String[] args) {
        SpringApplication.run(LuvanoAutoApplication.class, args);
    }

    @PostMapping("/api/bookings")
    public Map<String, Object> createBooking(
            @RequestBody Map<String, Object> data) {

        String[] required = {
                "name", "mobile", "location", "category",
                "carDetails", "duration", "time",
                "startDate", "total", "utr"
        };

        for (String field : required) {
            Object value = data.get(field);

            if (value == null || value.toString().isBlank()) {
                throw new IllegalArgumentException(
                        "Missing field: " + field);
            }
        }

        String bookingId = "LA-" +
                UUID.randomUUID()
                        .toString()
                        .substring(0, 8)
                        .toUpperCase(Locale.ROOT);

        Map<String, Object> booking = new LinkedHashMap<>(data);

        booking.put("bookingId", bookingId);
        booking.put("receivedAt", Instant.now().toString());
        booking.put("paymentStatus", "UNVERIFIED");
        booking.put("bookingStatus", "PENDING_CONFIRMATION");

        bookings.put(bookingId, booking);

        return Map.of(
                "bookingId", bookingId,
                "paymentStatus", "UNVERIFIED",
                "bookingStatus", "PENDING_CONFIRMATION"
        );
    }

    @GetMapping("/api/bookings")
    public Collection<Map<String, Object>> getBookings() {
        return bookings.values();
    }
}
